#!/usr/bin/env bash
#MISE description="Generate prerecorded English answers for public phrases, sentences and stories"
set -euo pipefail
node scripts/cw-training/passage-speech.mjs
speech_provider="$(python3 -B -c 'import json; from pathlib import Path; print(json.loads(Path("data/cw-training/passage-speech.json").read_text())["generator"]["engine"])')"
if [[ "$speech_provider" == "elevenlabs" ]]; then
  python3 -B scripts/cw-training/speech/generate.py --manifest data/cw-training/passage-speech.json "$@"
else
  uv run --project scripts/cw-training/speech python -B scripts/cw-training/speech/generate.py --manifest data/cw-training/passage-speech.json "$@"
fi
