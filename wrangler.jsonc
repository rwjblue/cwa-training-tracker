{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cwa-training-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cwa.n1rwj.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cwa-training-tracker",
      "database_id": "776114f6-3c5b-4a7f-afaf-8ea465c40f09",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["signin@cwa.n1rwj.com"] }],
  "secrets": { "required": ["AUTH_SECRET"] },
  "vars": {
    "APP_ORIGIN": "https://cwa.n1rwj.com",
    "EMAIL_FROM": "signin@cwa.n1rwj.com",
    "ENVIRONMENT": "production",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["17 4 * * *"] },
}
